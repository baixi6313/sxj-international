/* 事现鉴小程序 · 全局样式（红金主题，rpx 适配） */
page { background: #f2f3f7; }

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin: 0 24rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(20,20,40,.05);
  border: 1rpx solid #ececf1;
}
.card-h3 {
  display: flex; align-items: center; gap: 14rpx;
  font-size: 32rpx; font-weight: 700; color: #1a1a2e; margin: 0 0 18rpx;
}
.card-h3::before {
  content: ""; width: 8rpx; height: 32rpx; background: #c41e3a;
  border-radius: 4rpx; display: inline-block;
}
.card p { margin: 14rpx 0; font-size: 28rpx; color: #33334a; line-height: 1.7; }
.muted { color: #6b6b7b; font-size: 26rpx; }
.pill {
  display: inline-block; font-size: 22rpx; font-weight: 700;
  padding: 4rpx 18rpx; border-radius: 40rpx;
  background: #fbf4e3; color: #d4a017; border: 1rpx solid #ecdcb0;
  margin: 12rpx 24rpx 0;
}

/* hook */
.hook {
  margin: 24rpx; padding: 40rpx 32rpx; border-radius: 28rpx;
  background: linear-gradient(135deg, #c41e3a, #9e1530); color: #fff;
  text-align: center; box-shadow: 0 12rpx 40rpx rgba(196,30,58,.28);
}
.hook-before { font-size: 28rpx; opacity: .92; }
.hook-arrow { font-size: 36rpx; margin: 16rpx 0; opacity: .7; }
.hook-after { font-size: 38rpx; font-weight: 700; }
.hook-sub { font-size: 24rpx; opacity: .85; margin-top: 18rpx;
  border-top: 1rpx solid rgba(255,255,255,.25); padding-top: 18rpx; }

/* you -> me */
.ym-grid { display: flex; align-items: stretch; gap: 12rpx; margin: 12rpx 0; }
.ym-card { flex: 1; border-radius: 20rpx; padding: 22rpx; font-size: 24rpx; }
.ym-you { background: #fbeef0; border: 1rpx solid #f3d2d8; }
.ym-me { background: #fbf4e3; border: 1rpx solid #ecdcb0; }
.ym-label { font-weight: 700; margin-bottom: 14rpx; font-size: 26rpx; }
.ym-card text { display: block; margin: 10rpx 0; color: #3a3a4d; }
.ym-mid { width: 84rpx; display: flex; flex-direction: column; align-items: center;
  justify-content: center; color: #c41e3a; font-size: 22rpx; font-weight: 600; text-align: center; }
.ym-circle { width: 72rpx; height: 72rpx; border: 3rpx solid #c41e3a; border-radius: 50%;
  display: flex; align-items: center; justify-content: center; margin-bottom: 8rpx; font-size: 32rpx; }

/* proposition */
.prop {
  margin: 0 24rpx 20rpx; background: #fff; border: 1rpx solid #ececf1;
  border-radius: 20rpx; padding: 24rpx 26rpx; position: relative; overflow: hidden;
}
.prop::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0;
  width: 8rpx; background: #c41e3a; opacity: .75; }
.prop.key { background: #fbf4e3; border-color: #ecdcb0; }
.prop.key::before { background: #d4a017; width: 10rpx; }
.p-no { font-size: 26rpx; font-weight: 800; color: #c41e3a; }
.prop.key .p-no { color: #d4a017; }
.p-title { font-size: 30rpx; font-weight: 700; margin: 4rpx 0 10rpx; }
.p-body { font-size: 26rpx; color: #3a3a4d; line-height: 1.6; }
.p-tag { display: inline-block; font-size: 22rpx; font-weight: 700; color: #fff;
  background: #d4a017; border-radius: 10rpx; padding: 2rpx 14rpx; margin-left: 12rpx; vertical-align: middle; }

/* compare */
.compare { display: flex; gap: 16rpx; margin: 12rpx 0; }
.c-box { flex: 1; border-radius: 20rpx; padding: 22rpx; font-size: 24rpx; }
.c-old { background: #f0f0f4; border: 1rpx solid #e2e2ea; }
.c-new { background: #fbeef0; border: 1rpx solid #f3d2d8; }
.c-tag { font-size: 22rpx; font-weight: 700; display: block; margin-bottom: 12rpx; }
.c-old .c-tag { color: #6b6b7b; }
.c-new .c-tag { color: #c41e3a; }

/* path (3 columns) */
.path-row { display: flex; gap: 14rpx; margin: 12rpx 0; }
.path-col { flex: 1; border-radius: 20rpx; padding: 22rpx 16rpx; text-align: center; }
.path-old { background: #f0f0f4; border: 1rpx solid #e2e2ea; }
.path-old2 { background: #f3f3f7; border: 1rpx solid #e2e2ea; }
.path-key { background: #fbeef0; border: 1rpx solid #f3d2d8; }
.path-t { font-size: 26rpx; font-weight: 700; color: #555; margin-bottom: 14rpx; }
.path-key .path-t { color: #c41e3a; }
.path-bar { height: 36rpx; border-radius: 8rpx; margin: 10rpx 0; display: flex;
  align-items: center; justify-content: center; font-size: 22rpx; color: #fff; }
.path-d { font-size: 22rpx; color: #555; margin-top: 14rpx; }

/* calc */
.calc-item { display: flex; align-items: baseline; justify-content: space-between;
  padding: 20rpx 8rpx; border-bottom: 1rpx dashed #ececf1; }
.calc-item:last-child { border-bottom: none; }
.ci-label { font-size: 26rpx; color: #6b6b7b; }
.ci-num { font-size: 32rpx; font-weight: 800; color: #c41e3a; }
.ci-num small { font-size: 22rpx; font-weight: 600; color: #6b6b7b; }
.calc-total { margin-top: 18rpx; background: #fbeef0; border-radius: 16rpx;
  padding: 22rpx; text-align: center; font-size: 28rpx; color: #9e1530; font-weight: 700; }

/* closing */
.closing { margin: 0 24rpx 24rpx; background: #fbf4e3; border: 1rpx solid #ecdcb0;
  border-radius: 20rpx; padding: 26rpx; font-size: 26rpx; color: #4a3f1a; line-height: 1.7; }
.closing .big { display: block; font-size: 30rpx; font-weight: 800; color: #9e1530; margin-bottom: 12rpx; }

/* about */
.ar-row { display: flex; gap: 18rpx; padding: 22rpx 0; border-bottom: 1rpx solid #ececf1; }
.ar-row:last-child { border-bottom: none; }
.ar-ic { flex: 0 0 60rpx; height: 60rpx; border-radius: 14rpx; background: #fbeef0;
  color: #c41e3a; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 28rpx; }
.ar-tx { font-size: 26rpx; color: #3a3a4d; line-height: 1.6; }
.ar-tx b { color: #1a1a2e; }

.footer-note { text-align: center; font-size: 22rpx; color: #a0a0b0; margin-top: 20rpx; padding-bottom: 12rpx; }
