.verifier-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 2rpx solid #f0f0f0;
  padding: 24rpx 0;
}

.verifier-item:last-child {
  border-bottom: none;
}

.verifier-name {
  font-size: 30rpx;
  color: #2b2b2b;
  font-weight: 500;
}

.verifier-role {
  font-size: 22rpx;
  color: #a23b32;
  border: 2rpx solid #a23b32;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  margin-left: 12rpx;
}

.verifier-meta {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.verifier-remove {
  color: #cf1322;
  font-size: 26rpx;
  padding: 10rpx 16rpx;
}
