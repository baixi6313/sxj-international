.desc-text {
  font-size: 28rpx;
  color: #444;
  line-height: 1.8;
}

.verifier-row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.verifier-row:last-child {
  border-bottom: none;
}

.verifier-name {
  font-size: 28rpx;
  color: #2b2b2b;
}

.verifier-role {
  font-size: 24rpx;
  color: #999;
}

.status-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.status-opt {
  border: 2rpx solid;
  border-radius: 10rpx;
  padding: 10rpx 20rpx;
  font-size: 24rpx;
}

.progress-list {
  margin-top: 24rpx;
  border-top: 2rpx solid #f0f0f0;
  padding-top: 20rpx;
}

.progress-item {
  margin-bottom: 16rpx;
}

.progress-time {
  font-size: 22rpx;
  color: #999;
}

.progress-text {
  font-size: 26rpx;
  color: #333;
}

.meta-line {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 8rpx;
}

.copy {
  color: #a23b32;
  margin-left: 12rpx;
}

/* 验证意见统计 */
.verdict-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.verdict-item {
  flex: 1;
  border-radius: 12rpx;
  padding: 18rpx 0;
  text-align: center;
  background: #f7f3ee;
}
.verdict-item.support { background: #eaf6e9; }
.verdict-item.oppose { background: #fbeaea; }
.verdict-item.doubt { background: #fbf3e3; }
.verdict-num {
  font-size: 38rpx;
  font-weight: 700;
  color: #2b2b2b;
}
.verdict-label {
  font-size: 22rpx;
  color: #888;
  margin-top: 4rpx;
}

.verification-list { margin-top: 8rpx; }
.verification-item {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}
.verification-item:last-child { border-bottom: none; }
.v-badge {
  flex-shrink: 0;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  height: fit-content;
  color: #fff;
}
.v-support { background: #67c23a; }
.v-oppose { background: #e06c6c; }
.v-doubt { background: #e6a23c; }
.v-body { flex: 1; }
.v-content { font-size: 26rpx; color: #333; line-height: 1.6; }
.v-meta { font-size: 22rpx; color: #999; margin-top: 6rpx; }

/* 证据链 */
.evidence-list { margin-top: 8rpx; }
.evidence-item {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}
.evidence-item:last-child { border-bottom: none; }
.e-kind {
  flex-shrink: 0;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  height: fit-content;
  color: #fff;
}
.e-progress { background: #409eff; }
.e-evidence { background: #7a1f1f; }
.e-clue { background: #909399; }
.e-body { flex: 1; }
.e-content { font-size: 26rpx; color: #333; line-height: 1.6; }
.e-meta { font-size: 22rpx; color: #999; margin-top: 6rpx; }

/* 操作入口 */
.action-row {
  display: flex;
  gap: 20rpx;
  margin: 0 24rpx 8rpx;
}
.btn-primary.half, .btn-secondary.half { flex: 1; text-align: center; }

.frozen-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #a23b32;
  background: #fbf0ef;
  border-radius: 8rpx;
  padding: 14rpx 16rpx;
  line-height: 1.6;
}

/* 第三层共识卡片 */
.consensus-card {
  background: #f4f8fb;
  border: 2rpx solid #dce8f2;
}
.consensus-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.c-item {
  flex: 1;
  background: #fff;
  border-radius: 12rpx;
  padding: 18rpx 0;
  text-align: center;
}
.c-num {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a5276;
  line-height: 1.2;
}
.c-label {
  font-size: 22rpx;
  color: #888;
  margin-top: 4rpx;
}
.chain-hash {
  font-size: 20rpx;
  color: #666;
  word-break: break-all;
  background: #fff;
  border-radius: 8rpx;
  padding: 12rpx 14rpx;
  line-height: 1.5;
}
.auto-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #6b7c8a;
  line-height: 1.6;
}

/* 转发卡片 */
.share-card { background: #f7fbf7; border: 2rpx solid #d7ecd7; }
.share-tip { font-size: 22rpx; color: #4a7a4a; line-height: 1.6; margin-bottom: 12rpx; }
.share-anchor {
  display: flex; gap: 12rpx; align-items: flex-start;
  background: #fff; border: 2rpx dashed #cfe3cf; border-radius: 10rpx; padding: 14rpx 16rpx;
}
.anchor-label { flex-shrink: 0; font-size: 22rpx; color: #4a7a4a; font-weight: 700; padding-top: 2rpx; }
.anchor-value { font-size: 20rpx; color: #555; word-break: break-all; line-height: 1.5; font-family: ui-monospace, Menlo, monospace; }

/* 跟贴·讨论 */
.reply-card { background: #faf8f3; border: 2rpx solid #ece4d4; }
.reply-tip { font-size: 22rpx; color: #8a6d3b; line-height: 1.6; margin-bottom: 14rpx; }
.reply-composer { display: flex; flex-direction: column; gap: 12rpx; }
.reply-author {
  background: #fff; border: 2rpx solid #e2dccd; border-radius: 10rpx;
  padding: 16rpx 18rpx; font-size: 26rpx;
}
.reply-input {
  width: 100%; background: #fff; border: 2rpx solid #e2dccd; border-radius: 10rpx;
  padding: 16rpx 18rpx; font-size: 26rpx; height: 150rpx; box-sizing: border-box;
}
.reply-post-row { display: flex; align-items: center; justify-content: space-between; }
.reply-count { font-size: 22rpx; color: #999; }
.btn-primary.small { flex: 0 0 auto; padding: 14rpx 28rpx; font-size: 26rpx; border-radius: 10rpx; }
.reply-list { margin-top: 18rpx; border-top: 2rpx solid #efe9dc; padding-top: 12rpx; }
.reply-item { padding: 14rpx 0; border-bottom: 2rpx solid #f0ebdf; }
.reply-item:last-child { border-bottom: none; }
.reply-meta { font-size: 22rpx; color: #888; margin-bottom: 6rpx; }
.reply-content { font-size: 27rpx; color: #333; line-height: 1.6; }
.reply-hash { font-size: 19rpx; color: #b08d4a; font-family: ui-monospace, Menlo, monospace; margin-top: 6rpx; }

/* 转发按钮（重置 WeChat 默认 button 样式） */
button.btn-primary { margin: 0; line-height: normal; }
button.btn-primary::after { border: none; }
