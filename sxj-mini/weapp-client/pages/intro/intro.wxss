.intro-hero {
  background: linear-gradient(135deg, #7a1f1f, #a23b32);
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  color: #fff;
  margin: 30rpx 30rpx 24rpx;
  text-align: center;
  box-shadow: 0 6rpx 24rpx rgba(122,31,31,0.25);
}

.intro-hero-emoji {
  font-size: 80rpx;
  line-height: 1;
  margin-bottom: 16rpx;
}

.intro-hero-title {
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.intro-hero-sub {
  font-size: 26rpx;
  opacity: 0.9;
}

.step {
  display: flex;
  align-items: flex-start;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin: 0 30rpx 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.step-icon {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #f7f1e3;
  border: 2rpx solid #e6d9b8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 24rpx;
}

.step-body {
  flex: 1;
}

.step-no {
  font-size: 32rpx;
  font-weight: 700;
  color: #7a1f1f;
  margin-bottom: 10rpx;
}

.step-text {
  font-size: 27rpx;
  color: #444;
  line-height: 1.75;
}

.intro-cta {
  margin: 30rpx 30rpx 10rpx;
}

.intro-skip {
  text-align: center;
  font-size: 26rpx;
  color: #999;
  margin-top: 22rpx;
  padding: 12rpx 0;
}

.footer {
  text-align: center;
  font-size: 22rpx;
  color: #aaa;
  padding: 30rpx 0 50rpx;
}
