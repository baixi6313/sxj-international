.filter-bar {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  padding: 12rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.filter-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #666;
  padding: 14rpx 0;
  border-radius: 8rpx;
}

.filter-item.active {
  background: #a23b32;
  color: #fff;
}

.event-item {
  border-bottom: 2rpx solid #f0f0f0;
  margin: 0 -30rpx;
  padding: 20rpx 30rpx;
}

.event-item:last-child {
  border-bottom: none;
}

.event-desc {
  font-size: 24rpx;
  color: #666;
  margin-top: 10rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
