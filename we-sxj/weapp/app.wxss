page {
  background: #eef3f8;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  color: #1f2d3d;
}
.page { padding: 24rpx; padding-bottom: 40rpx; }

/* cards */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(30, 136, 229, 0.06);
}
.card-title { font-size: 32rpx; font-weight: 600; color: #1e88e5; margin-bottom: 18rpx; }
.para { font-size: 28rpx; line-height: 1.7; color: #5a6b7b; margin-bottom: 10rpx; }
.hint { font-size: 26rpx; color: #8a9bb0; line-height: 1.6; }
.empty { font-size: 26rpx; color: #b0bcc9; text-align: center; padding: 30rpx 0; }
.empty-card { text-align: center; color: #b0bcc9; padding: 70rpx 0; font-size: 28rpx; }

/* buttons */
.primary-btn {
  background: #1e88e5; color: #fff; border-radius: 40rpx;
  font-size: 28rpx; padding: 8rpx 36rpx; line-height: 2; margin: 0;
}
.assist-btn {
  background: #26a69a; color: #fff; border-radius: 40rpx;
  font-size: 26rpx; padding: 8rpx 28rpx; line-height: 2; margin: 0;
}
button::after { border: none; }

/* profile */
.profile-card {
  display: flex; align-items: center; background: #fff;
  border-radius: 20rpx; padding: 28rpx; margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(30, 136, 229, 0.06);
}
.avatar {
  width: 88rpx; height: 88rpx; border-radius: 50%;
  background: #1e88e5; color: #fff; font-size: 38rpx;
  display: flex; align-items: center; justify-content: center; font-weight: 600;
}
.profile-info { flex: 1; margin-left: 22rpx; }
.profile-name { font-size: 32rpx; font-weight: 600; color: #1f2d3d; }
.profile-sub { font-size: 24rpx; color: #8a9bb0; margin-top: 6rpx; }
.profile-edit { font-size: 26rpx; color: #1e88e5; }

/* progress */
.progress-num { display: flex; align-items: baseline; margin: 8rpx 0 18rpx; }
.big { font-size: 56rpx; font-weight: 700; color: #1e88e5; }
.unit { font-size: 26rpx; color: #8a9bb0; margin-left: 10rpx; }
.bar { height: 18rpx; background: #e3ebf3; border-radius: 10rpx; overflow: hidden; }
.bar-fill { height: 100%; background: linear-gradient(90deg, #1e88e5, #26a69a); border-radius: 10rpx; transition: width .3s; }
.bar-tip { font-size: 24rpx; color: #26a69a; margin-top: 10rpx; }

/* quick + inputs */
.quick-row { display: flex; gap: 16rpx; margin-bottom: 18rpx; }
.quick-btn {
  flex: 1; text-align: center; background: #eaf3fc; color: #1e88e5;
  border-radius: 12rpx; padding: 16rpx 0; font-size: 28rpx;
}
.input-row { display: flex; align-items: center; gap: 16rpx; margin-top: 12rpx; }
.ml-input, .name-input {
  flex: 1; background: #f3f6fa; border-radius: 12rpx; padding: 16rpx 20rpx;
  font-size: 28rpx;
}
.ml-unit { font-size: 26rpx; color: #8a9bb0; }
.hint { font-size: 24rpx; color: #b0bcc9; margin-top: 14rpx; }

/* records list */
.rec-item {
  display: flex; align-items: center; padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f3f7;
}
.rec-item:last-child { border-bottom: none; }
.rec-ml { font-size: 30rpx; font-weight: 600; color: #1f2d3d; width: 140rpx; }
.rec-meta { flex: 1; font-size: 24rpx; color: #8a9bb0; display: flex; flex-direction: column; gap: 4rpx; }
.tag-self { color: #1e88e5; }
.tag-assist { color: #26a69a; }
.rec-hash { font-size: 22rpx; color: #c2ccd8; font-family: monospace; }

/* confirm */
.confirm-item .confirm-head { display: flex; justify-content: space-between; align-items: center; }
.confirm-name { font-size: 32rpx; font-weight: 600; color: #1f2d3d; }
.confirm-ml { font-size: 26rpx; color: #26a69a; }
.confirm-date { font-size: 24rpx; color: #b0bcc9; margin: 8rpx 0 18rpx; }
.confirm-actions { display: flex; gap: 20rpx; }
.btn-confirm { flex: 1; background: #1e88e5; color: #fff; border-radius: 40rpx; font-size: 28rpx; padding: 8rpx 0; line-height: 2; margin: 0; }
.btn-reject { flex: 1; background: #f3f6fa; color: #8a9bb0; border-radius: 40rpx; font-size: 28rpx; padding: 8rpx 0; line-height: 2; margin: 0; }

/* ranking */
.rank-item { display: flex; align-items: center; }
.rank-no {
  width: 56rpx; height: 56rpx; border-radius: 50%; background: #eaf3fc; color: #1e88e5;
  display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 28rpx; margin-right: 20rpx;
}
.rank-no-1 { background: #ffd54f; color: #8a6d00; }
.rank-no-2 { background: #cfd8dc; color: #546e7a; }
.rank-no-3 { background: #ffcc80; color: #8a4b00; }
.rank-main { flex: 1; }
.rank-name { font-size: 32rpx; font-weight: 600; color: #1f2d3d; }
.rank-sub { font-size: 24rpx; color: #8a9bb0; margin-top: 6rpx; }
.rank-people { font-size: 44rpx; font-weight: 700; color: #1e88e5; text-align: right; }
.rank-people-unit { font-size: 24rpx; color: #8a9bb0; margin-left: 4rpx; }

/* feedback */
.reason-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 20rpx; }
.reason-btn {
  background: #f3f6fa; color: #5a6b7b; border-radius: 40rpx;
  padding: 14rpx 28rpx; font-size: 26rpx;
}
.reason-on { background: #1e88e5; color: #fff; }
.fb-detail {
  width: 100%; box-sizing: border-box; background: #f3f6fa; border-radius: 12rpx;
  padding: 18rpx 20rpx; font-size: 28rpx; height: 140rpx; margin-bottom: 20rpx;
}
.fb-item { padding: 16rpx 0; border-bottom: 1rpx solid #f0f3f7; }
.fb-item:last-child { border-bottom: none; }
.fb-reason { font-size: 28rpx; color: #1f2d3d; font-weight: 500; }
.fb-meta { font-size: 24rpx; color: #b0bcc9; margin-top: 6rpx; }

/* about */
.hero { text-align: center; padding: 50rpx 0 30rpx; }
.hero-logo { font-size: 64rpx; font-weight: 800; color: #1e88e5; letter-spacing: 2rpx; }
.hero-sxj { color: #26a69a; }
.hero-sub { font-size: 26rpx; color: #8a9bb0; margin-top: 12rpx; }
.feat { display: flex; gap: 16rpx; font-size: 28rpx; line-height: 1.6; color: #5a6b7b; margin-bottom: 16rpx; }
.feat-n { color: #1e88e5; font-weight: 700; flex-shrink: 0; }
.footer { text-align: center; font-size: 24rpx; color: #b0bcc9; margin-top: 30rpx; }
