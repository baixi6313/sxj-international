.filter-bar { display:flex; flex-wrap:wrap; gap:12rpx; margin:16rpx 0 8rpx; }
.filter-item {
  padding: 8rpx 24rpx; border-radius: 28rpx; font-size: 24rpx;
  background:#122c4f; color:#9fb3cc; border:1rpx solid #1d3e66;
}
.filter-item.active { background:#1d6fd0; color:#fff; border-color:#1d6fd0; }
.event { transition: transform .1s; }
.event:active { transform: scale(.99); }
